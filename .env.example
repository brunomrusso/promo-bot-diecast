# Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=id_do_canal_ou_grupo
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id_pessoal

# Mercado Livre API (crie app grátis em developers.mercadolivre.com.br)
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Lomadee (rede de afiliados: cobre ML, Shopee, Amazon...)
LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# Afiliados (preencher depois de se cadastrar)
AMAZON_TAG=seu-tag-20
SHOPEE_AFFILIATE_ID=
ML_AFFILIATE_PREFIX=
# Proxy residencial para o trafego do Mercado Livre (IP de datacenter e bloqueado).
# Formato: http://usuario:senha@host:porta — vazio desativa.
ML_PROXY_URL=

# Config
ENABLED_STORES=amazon
CHECK_INTERVAL_MINUTES=15
